#!/bin/bash
# Runs a command in the psion-build container, with the work area mounted
# at the same path so the SDK's absolute paths and symlinks keep working.
# This script lives in psion-core, which the programs carry as the submodule
# core/: run it from a program's checkout as core/tools/docker/psibuild.
#
#   core/tools/docker/psibuild setup        build the image, fetch and install the SDK
#   core/tools/docker/psibuild all          the program's build.sh (dist/*.sis), then
#                                           tools/docker/psibuild.local's builds, if it is here
#   core/tools/docker/psibuild <command>    anything else, e.g. "bash build.sh host"
#
# Layout (PSION_WORK, default: the folder above the program's checkout):
#   $PSION_WORK/<program>             a checkout (psiterm, psimail, psiweb...) with core/
#   $PSION_WORK/psion_cpp_sdk_linux   the EPOC R5 C++ SDK for Linux
#   $PSION_WORK/.wine                 wine's prefix (bmconv, makesis, makmake...)
# PSION_APP names the program's checkout when core is not its core/ submodule
# (default: the folder above this core checkout).
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
CORE=$(cd "$HERE/../.." && pwd)
APP=${PSION_APP:-$(cd "$CORE/.." && pwd)}
WORK=${PSION_WORK:-$(cd "$APP/.." && pwd)}
SDK=$WORK/psion_cpp_sdk_linux
SDK_URL=https://github.com/static-void/psion_cpp_sdk_linux.git
SDK_REV=7763ee8
IMAGE=psion-build

run() {
	docker run --rm -i $( [ -t 0 ] && echo -t ) \
		--user "$(id -u):$(id -g)" \
		-v "$WORK:$WORK" -w "$PWD" \
		-e HOME="$WORK" -e WINEPREFIX="$WORK/.wine" -e WINEDEBUG=-all \
		-e PSION_SDK="$SDK" -e PSION_APP="$APP" \
		"$IMAGE" bash -c "$*"
}

case "$1" in
setup)
	docker build -t "$IMAGE" "$HERE"
	if [ ! -d "$SDK" ]; then
		git clone "$SDK_URL" "$SDK"
		git -C "$SDK" checkout -q "$SDK_REV"
	fi
	run "wineboot -i >/dev/null 2>&1 || true"      # (install.sh links into the prefix)
	if [ ! -d "$SDK/epoc_cpp_sdk/epoc32" ]; then
		run "cd '$SDK/install' && ./install.sh" > "$WORK/sdk-install.log" 2>&1 \
			|| { tail -20 "$WORK/sdk-install.log"; exit 1; }
	fi
	[ -d "$SDK/epoc_cpp_sdk/epoc32" ] || { echo "SDK install failed: see $WORK/sdk-install.log"; exit 1; }
	echo "SDK ready in $SDK"
	;;
all)
	cd "$APP"
	# (tools/docker/psibuild.local, if here - not part of the repository -
	# holds commands for other builds in this checkout, run after the program's)
	run "bash build.sh && { [ ! -f tools/docker/psibuild.local ] || bash tools/docker/psibuild.local; }"
	ls -la "$APP"/dist/*.sis
	;;
"")
	sed -n '2,17p' "$0"
	;;
*)
	run "$*"
	;;
esac
