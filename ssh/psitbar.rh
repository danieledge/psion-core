// psitbar.rh - the bundled programs' toolbars, one source for every machine
// (PsiTerm, PsiMail, PsiWeb; the Coda sheet 2.2 and 2.13). With psitbar.h.
//
// A program declares each of its toolbars three times, one after the other,
// so that rcomp numbers them in a row and psitbar.h picks one by adding
// PsiTbarKind() to the first's id:
//
//   RESOURCE TOOLBAR r_xx_toolbar      { PSI_TB_SHORT(EXxCmdName, XX_BUTTONS(PSI_TB_BUTTON_SHORT)) }
//   RESOURCE TOOLBAR r_xx_toolbar_tall { PSI_TB_TALL(EXxCmdName, XX_BUTTONS(PSI_TB_BUTTON_TALL)) }
//   RESOURCE TOOLBAR r_xx_toolbar_coda { PSI_TB_CODA(EXxCmdName, XX_BUTTONS(PSI_TB_BUTTON_TALL)) }
//
// where XX_BUTTONS(LEN) is the program's #define of its TBAR_BUTTONs and
// TBAR_CTRLs, each with length=LEN.
//   - SHORT: a 240-line screen (the Series 5mx): buttons of 37, as Psion's.
//   - TALL: a 480-line screen without Coda (the Series 7, Psion's own
//     netBook image): buttons of 50, as the netBook's own programs.
//   - CODA: the netBook with Coda: buttons of 50, then the netBook's battery,
//     Coda's extras block (charge, free memory, brightness: PsiBatt.dll) and
//     Coda's clock, as every built-in program's toolbar has them
//     (psion-netbook tools/toolbars.mts). Those three types are made by
//     Coda's hook in Eikon's control factory; psitbar.h chooses this one only
//     when the hook is in the ROM.
// Every kind starts with the name box: a CEikFileNameLabel of 24, as Psion's
// programs have it (bold, boxed; on Coda in the theme's colours, and a tap
// opens PsiHub). psitbar.h sets its text.
//
// The toolbar's breadth is EIKON's standard 70 in every kind.

#ifndef PSITBAR_RH
#define PSITBAR_RH

#define PSI_TB_BUTTON_SHORT	KEikStdToolBarButtonHeight	// 37
#define PSI_TB_BUTTON_TALL	50

// the netBook's own battery (type 0x47 on Psion's toolbars, 0x7044 on
// Coda's, which opens Control panel > Battery when tapped): its 17 bytes of
// fields as Psion's toolbars have them
STRUCT PSI_TB_BATTERY
	{
	BYTE b0=0xff; BYTE b1=0xff; BYTE b2=0xff; BYTE b3=0xff;
	BYTE b4=0x0a; BYTE b5=0x00; BYTE b6=0x00; BYTE b7=0x03;
	BYTE b8=0x00; BYTE b9=0x00; BYTE b10=0x00; BYTE b11=0x18;
	BYTE b12=0x00; BYTE b13=0xb5; BYTE b14=0xb1; BYTE b15=0xf3; BYTE b16=0x00;
	}

#define PSI_TB_TYPE_BATTERY	0x7044	// Coda's battery (Psion's inside)
#define PSI_TB_TYPE_EXTRAS	0x7042	// PsiBatt's block (a spacer's fields)
#define PSI_TB_TYPE_CLOCK	0x7043	// Coda's clock (Psion's inside, Coda's faces a tap away)

#define PSI_TB_NAME(ID) \
	TBAR_CTRL { type=EEikCtFileNameLabel; id=ID; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdFileNameLabelHeight; }

#define PSI_TB_END(CLOCKTYPE) \
	TBAR_CTRL { type=EEikCtSpacer; flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable; length=0; control=SPACER; }, \
	TBAR_CTRL { type=CLOCKTYPE; control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; }; }, \
	TBAR_CTRL { type=EEikCtSpacer; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdGapBelowClock; control=SPACER; }

#define PSI_TB_SHORT(NAMEID, BUTTONS) \
	breadth=KEikStdToolBarWidth; \
	controls= { PSI_TB_NAME(NAMEID), BUTTONS, PSI_TB_END(EEikCtClock) };

// (the same as SHORT, written out: a macro handing on BUTTONS, commas and
// all, to another would split it into more arguments)
#define PSI_TB_TALL(NAMEID, BUTTONS) \
	breadth=KEikStdToolBarWidth; \
	controls= { PSI_TB_NAME(NAMEID), BUTTONS, PSI_TB_END(EEikCtClock) };

#define PSI_TB_CODA(NAMEID, BUTTONS) \
	breadth=KEikStdToolBarWidth; \
	controls= { PSI_TB_NAME(NAMEID), BUTTONS, \
		TBAR_CTRL { type=PSI_TB_TYPE_BATTERY; control=PSI_TB_BATTERY { }; }, \
		TBAR_CTRL { type=PSI_TB_TYPE_EXTRAS; control=SPACER; }, \
		PSI_TB_END(PSI_TB_TYPE_CLOCK) };

#endif
