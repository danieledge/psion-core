// pgsetup.rssi - the resources of the setup assistant (pgsetup.h): its two
// shared pages, their choices and its buttons. A program includes this in
// its .rss after its EIK_APP_INFO (a resource file's first resources must
// stay its own), and builds its own DIALOG from the pages (it may add pages
// of its own after them):
//
//   #define PGSU_TXT_HELPER_PROMPT "Web pictures are fetched by"   (optional)
//   #include "pgsetup.rssi"
//   RESOURCE DIALOG r_pm_setup_dialog
//       {
//       title="Set up PsiMail";
//       flags=EEikDialogFlagWait;
//       buttons=r_pgsu_buttons;
//       pages=r_pm_setup_pages;
//       }
//   RESOURCE ARRAY r_pm_setup_pages
//       {
//       items=
//           {
//           PAGE { text="Connection"; id=EPgSuPageConn; lines=r_pgsu_conn_lines; },
//           PAGE { text="Web helper"; id=EPgSuPageHelper; lines=r_pgsu_helper_lines; }
//           };
//       }
//
// and gives the assistant its PsiProxy question's dialog (below):
//   new CPgSetupDialog(R_XX_TEST_DIALOG, EXxDlgTest1, R_PGSU_QUERY_DIALOG)
//
// The words of the choices are in psilink.rh; the annotations, which change
// with the choice, are in pgsetup.cpp (a label's resource text is only the
// longest of them, so the dialog is the same size whatever is chosen).
#include "psilink.rh"
#include "pgsetup.hrh"

#ifndef PGSU_TXT_HELPER_PROMPT
#define PGSU_TXT_HELPER_PROMPT "Pages are fetched by"
#endif

RESOURCE ARRAY r_pgsu_conn_lines
	{
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="This Psion goes online by"; id=EPgSuDlgConn;
			control=CHOICELIST { maxdisplaychar=16; array_id=r_pgsu_conn_array; }; },
		DLG_LINE { type=EEikCtLabel; id=EPgSuDlgConnNote; control=LABEL { standard_font=EEikLabelFontAnnotation;
			horiz_align=EEikLabelAlignHLeft; reserve_length=72;
			txt="The PC Card network card, or a dial-up, as set in the Control panel"; }; },
		DLG_LINE { type=EEikCtChoiceList; prompt="Speed"; id=EPgSuDlgBaud;
			control=CHOICELIST { maxdisplaychar=8; array_id=r_pgsu_baud_array; }; }
		};
	}

RESOURCE ARRAY r_pgsu_helper_lines
	{
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt=PGSU_TXT_HELPER_PROMPT; id=EPgSuDlgHelper;
			control=CHOICELIST { maxdisplaychar=16; array_id=r_pgsu_helper_array; }; },
		DLG_LINE { type=EEikCtLabel; id=EPgSuDlgHelperNote; control=LABEL { standard_font=EEikLabelFontAnnotation;
			horiz_align=EEikLabelAlignHLeft; reserve_length=72;
			txt="Fastest - get it at github.com/danieledge/psiproxy"; }; },
		DLG_LINE { type=EEikCtEdwin; prompt=PSILINK_TXT_HELPER_HOST; id=EPgSuDlgHost;
			control=EDWIN { width=18; maxlength=60; }; },
		DLG_LINE { type=EEikCtNumberEditor; prompt="Port"; id=EPgSuDlgPort;
			control=NUMBER_EDITOR { min=1; max=65535; }; }
		};
	}

// in the order of PG_SU_CONN_*
RESOURCE ARRAY r_pgsu_conn_array
	{
	items={ LBUF { txt="Network card or dial-up"; }, LBUF { txt="Atom modem"; }, LBUF { txt="Other WiFi modem"; } };
	}

// in the order of PG_SU_HELPER_*
RESOURCE ARRAY r_pgsu_helper_array
	{
	items={ LBUF { txt=PSILINK_TXT_DIRECT; }, LBUF { txt=PSILINK_TXT_ATOM_HELPER; }, LBUF { txt=PSILINK_TXT_PSIPROXY; } };
	}

RESOURCE ARRAY r_pgsu_baud_array
	{
	items={ LBUF { txt="9600"; }, LBUF { txt="19200"; }, LBUF { txt="38400"; }, LBUF { txt="57600"; }, LBUF { txt="115200"; } };
	}

// Test (Ctrl+T) tries the settings shown, before OK, in the program's own
// Test connection window; Cancel leaves every setting as it was
RESOURCE DLG_BUTTONS r_pgsu_buttons
	{
	buttons=
		{
		DLG_BUTTON { id=EPgSuBidTest; button=CMBUT { txt="Test"; }; hotkey='T'; },
		DLG_BUTTON { id=EEikBidCancel; button=CMBUT { txt="Cancel"; }; hotkey=EEikBidCancel; flags=0; },
		DLG_BUTTON { id=EEikBidOk; button=CMBUT { txt="OK"; }; hotkey=EEikBidOk; flags=0; }
		};
	}

// (22 November 2026) The PsiProxy question (CPgSuQueryDialog), asked on OK
// only when PsiProxy on a computer is new to the settings. Its words are in
// the dialog, not its title bar: the fact in bold, why as an annotation
// under it, then the question, last, before No and Yes (Esc is No, Enter is
// not Yes). The labels hold the longest text they take (pgsetup.h's
// PG_SU_QUERY_*), so the dialog has one size whatever it says; a label's
// reserve_length must be at least anything set in it later (USER 23)
RESOURCE DIALOG r_pgsu_query_dialog
	{
	title="PsiProxy on a computer";
	flags=EEikDialogFlagWait;
	buttons=R_EIK_BUTTONS_NO_YES;
	items=
		{
		DLG_LINE { type=EEikCtLabel; id=EPgSuDlgQueryFact; control=LABEL { horiz_align=EEikLabelAlignHLeft; reserve_length=64;
			txt="Pages and passwords cross your network unencrypted"; }; },
		DLG_LINE { type=EEikCtLabel; id=EPgSuDlgQueryWhy; control=LABEL { standard_font=EEikLabelFontAnnotation;
			horiz_align=EEikLabelAlignHLeft; reserve_length=110;
			txt="Between this Psion and PsiProxy at WWWWWWWWWWWWWWW. Do not use on public WiFi"; }; },
		DLG_LINE { type=EEikCtLabel; id=EPgSuDlgQueryQuestion; control=LABEL { horiz_align=EEikLabelAlignHLeft; reserve_length=64;
			txt="Use PsiProxy on this network?"; }; }
		};
	}
