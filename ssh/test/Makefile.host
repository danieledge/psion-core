# Host tests for the shared connection layer (run in core/ssh):
#   make -f test/Makefile.host test      build and run them all
# Each one is a PC program; nothing here needs the EPOC SDK.

all: linktest linkseentest psilinktest pgdevboxtest psiholdtest setuptest aesgcmtest tlstest psialloctest psierrtest

# Connection settings > Test: the pure part of pg_link_test (no EPOC calls)
linktest: test/linktest.cpp psiglue.cpp pglinktest.h
	g++ -Wall -O1 -g -DPG_LINK_TEST_ONLY -DPG_LINK_TEST_HOST -I test/stubinc -I . test/linktest.cpp -o $@

# The shared link's last sign of life: when a failed probe may hang up the
# link every program shares (pglinkseen.h)
linkseentest: test/linkseentest.cpp pglinkseen.h
	g++ -Wall -O1 -g test/linkseentest.cpp -o $@

# PsiLink.ini, the shared connection settings: every version loads (psilink.h)
psilinktest: test/psilinktest.cpp psilink.h
	g++ -Wall -O1 -g test/psilinktest.cpp -o $@

# Where PsiProxy's services are, and which answers are its, for the engines (pgdevbox.h)
pgdevboxtest: test/pgdevboxtest.c pgdevbox.h
	gcc -Wall -O1 -g -fsanitize=address,undefined test/pgdevboxtest.c -o $@

# psihold.exe found by reading \System\Apps\, not by program names (psilink.h)
psiholdtest: test/psiholdtest.cpp psilink.h
	g++ -Wall -O1 -g -fsanitize=address,undefined test/psiholdtest.cpp -o $@

# AES-128-GCM, TLS 1.3's second cipher (aesgcm.c): FIPS-197 and the GCM vectors
aesgcmtest: test/aesgcmtest.c aesgcm.c aesgcm.h
	gcc -Wall -Wextra -O1 -g -fsanitize=address,undefined -I . test/aesgcmtest.c aesgcm.c -o $@

# The setup assistant's choices and what they write (pgsetup.h)
setuptest: test/setuptest.cpp pgsetup.h pgsetup.hrh
	g++ -Wall -Wextra -O1 -g -fsanitize=address,undefined -I . test/setuptest.cpp -o $@

# TLS 1.3 (tls13.c) against OpenSSL's s_server: lines both ways, the server's
# KeyUpdates, with and without asking for ours (test/tlstest.py; skipped
# without openssl). Built with libtomcrypt's ChaCha20-Poly1305, AES-GCM
# (aesgcm.c), Dropbear's X25519, session tickets on (test/tlshost/)
TLS_LTC := stream/chacha/chacha_crypt stream/chacha/chacha_ivctr32 stream/chacha/chacha_keystream \
	stream/chacha/chacha_setup stream/chacha/chacha_done mac/poly1305/poly1305 hashes/sha2/sha256 \
	hashes/sha2/sha384 hashes/sha2/sha512 misc/zeromem misc/burn_stack misc/crypt/crypt_argchk misc/compare_testvector
TLS_SRCS := test/tlstest.c tls13.c aesgcm.c db/src/curve25519.c $(addprefix db/libtomcrypt/src/,$(TLS_LTC:=.c))
tlstest: $(TLS_SRCS) tls13.h test/tlshost/includes.h test/tlshost/options.h
	gcc -O1 -g -w -std=gnu99 -fsanitize=address,undefined -I test/tlshost -I . -I db/src -I db/libtomcrypt/src/headers \
		-DLTC_SOURCE -DLTC_NO_ASM $(TLS_SRCS) -o $@

# (P2-05, P2-06) psialloc.c and psivec.h: big blocks in chunks of their own
psialloctest: test/psialloctest.c psialloc.c psialloc.h psivec.h psiwork.h
	gcc -Wall -O1 -g -fsanitize=address,undefined -I . test/psialloctest.c psialloc.c -o $@

# An error in words for a message (psierr.h): no tail for an unknown reason,
# every length cut to the buffer (test/errstub's descriptors panic as ER5's)
psierrtest: test/psierrtest.cpp psierr.h test/errstub/e32std.h
	g++ -Wall -Wextra -O1 -g -fsanitize=address,undefined -I test/errstub -I . test/psierrtest.cpp -o $@

test: all
	./linktest
	./linkseentest
	./psilinktest
	./pgdevboxtest
	./psiholdtest
	./setuptest
	./aesgcmtest
	./psialloctest
	./psierrtest
	python3 test/tlstest.py ./tlstest

clean:
	rm -f linktest linkseentest psilinktest pgdevboxtest psiholdtest setuptest aesgcmtest tlstest psialloctest psierrtest

.PHONY: all test clean
